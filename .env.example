# Google Gemini API key (paid tier required for client-confidential data)
GEMINI_API_KEY=your_key_here
# Models tried in order; the client falls back on 429/503/404
GEMINI_MODELS=gemini-3.6-flash,gemini-3.7-flash,gemini-3.5-flash,gemini-3.1-flash-lite,gemini-flash-lite-latest
# Where project data is stored (git-ignored)
CA_PROJECTS_DIR=projects
